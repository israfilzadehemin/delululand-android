<?xml version="1.0" encoding="utf-8"?>
<!-- The full-screen video (VideoPlayer.kt): a TextureView surface, so the grow/shrink transition
     can scale it (a SurfaceView ignores view transforms on older Android versions). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/black" />
